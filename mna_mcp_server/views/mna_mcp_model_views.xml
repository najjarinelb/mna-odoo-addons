<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mna_mcp_model_view_list" model="ir.ui.view">
        <field name="name">mna.mcp.model.list</field>
        <field name="model">mna.mcp.model</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="model_id"/>
                <field name="model"/>
                <field name="allow_read" widget="boolean_toggle"/>
                <field name="allow_create" widget="boolean_toggle"/>
                <field name="allow_write" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="mna_mcp_model_view_search" model="ir.ui.view">
        <field name="name">mna.mcp.model.search</field>
        <field name="model">mna.mcp.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="model"/>
                <filter name="writable" string="Writable" domain="['|', ('allow_create', '=', True), ('allow_write', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="mna_mcp_model_action" model="ir.actions.act_window">
        <field name="name">Exposed Models</field>
        <field name="res_model">mna.mcp.model</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Expose a model to MCP</p>
            <p>Nothing is reachable by an AI client until it is listed here.
               Read is on by default; create and update must be switched on per model.</p>
        </field>
    </record>
</odoo>
