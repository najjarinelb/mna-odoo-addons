<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mna_mcp_key_view_list" model="ir.ui.view">
        <field name="name">mna.mcp.key.list</field>
        <field name="model">mna.mcp.key</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <header>
                    <button name="%(mna_mcp_key_wizard_action)d" type="action" string="New Key" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_hint"/>
                <field name="expiration_date"/>
                <field name="last_used"/>
                <field name="create_date" string="Created"/>
            </list>
        </field>
    </record>

    <record id="mna_mcp_key_action" model="ir.actions.act_window">
        <field name="name">MCP Keys</field>
        <field name="res_model">mna.mcp.key</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate an MCP key</p>
            <p>Each key runs as one Odoo user. Delete a key to revoke it instantly.</p>
        </field>
    </record>
</odoo>
