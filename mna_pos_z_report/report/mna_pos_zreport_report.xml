<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_mna_pos_zreport" model="ir.actions.report">
        <field name="name">X / Z Report</field>
        <field name="model">mna.pos.zreport</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mna_pos_z_report.report_zreport</field>
        <field name="report_file">mna_pos_z_report.report_zreport</field>
        <field name="print_report_name">object.name</field>
        <field name="binding_model_id" ref="model_mna_pos_zreport"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_zreport">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-if="doc.report_type == 'z'">Z Report</span>
                            <span t-else="">X Report</span>
                            <span t-field="doc.name" class="ms-2"/>
                        </h2>

                        <div class="row mt-3 mb-4">
                            <div class="col-3">
                                <strong>Point of sale</strong><br/>
                                <span t-field="doc.config_id.name"/>
                            </div>
                            <div class="col-3">
                                <strong>Session</strong><br/>
                                <span t-field="doc.session_id.name"/>
                            </div>
                            <div class="col-3">
                                <strong>Opened by</strong><br/>
                                <span t-field="doc.cashier_id.name"/>
                            </div>
                            <div class="col-3">
                                <strong>Taken</strong><br/>
                                <span t-field="doc.date_taken"/>
                            </div>
                        </div>

                        <h4>Trade</h4>
                        <table class="table table-sm">
                            <tr>
                                <td>Orders</td><td class="text-end"><span t-field="doc.order_count"/></td>
                                <td>Refunds</td><td class="text-end"><span t-field="doc.refund_count"/></td>
                                <td>Items</td><td class="text-end"><span t-field="doc.item_count"/></td>
                                <td>Average basket</td>
                                <td class="text-end"><span t-field="doc.average_basket"/></td>
                            </tr>
                        </table>

                        <h4>Sales</h4>
                        <table class="table table-sm">
                            <tr><td>Gross</td><td class="text-end"><span t-field="doc.gross_sales"/></td></tr>
                            <tr><td>Discount given</td><td class="text-end"><span t-field="doc.discount_total"/></td></tr>
                            <tr><td>Net of tax</td><td class="text-end"><span t-field="doc.net_sales"/></td></tr>
                            <tr><td>Tax</td><td class="text-end"><span t-field="doc.tax_total"/></td></tr>
                            <tr style="border-top: 2px solid #000;">
                                <td><strong>Total taken</strong></td>
                                <td class="text-end"><strong><span t-field="doc.total_sales"/></strong></td>
                            </tr>
                            <tr t-if="doc.refund_total">
                                <td>Of which refunded</td>
                                <td class="text-end"><span t-field="doc.refund_total"/></td>
                            </tr>
                        </table>

                        <h4>Payment methods</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Method</th><th class="text-end">Transactions</th>
                                    <th class="text-end">Amount</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.payment_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.count"/></td>
                                    <td class="text-end"><span t-field="line.amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Tax</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Rate</th><th class="text-end">Base</th>
                                    <th class="text-end">Tax</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.tax_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.base"/></td>
                                    <td class="text-end"><span t-field="line.amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 t-if="doc.category_line_ids">Categories</h4>
                        <table class="table table-sm" t-if="doc.category_line_ids">
                            <thead>
                                <tr><th>Category</th><th class="text-end">Items</th>
                                    <th class="text-end">Net</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.category_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.amount"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h4>Cash</h4>
                        <table class="table table-sm">
                            <tr><td>Opening float</td><td class="text-end"><span t-field="doc.opening_float"/></td></tr>
                            <tr><td>Cash taken</td><td class="text-end"><span t-field="doc.cash_sales"/></td></tr>
                            <tr><td>Money put in</td><td class="text-end"><span t-field="doc.cash_in"/></td></tr>
                            <tr><td>Money taken out</td><td class="text-end"><span t-field="doc.cash_out"/></td></tr>
                            <tr style="border-top: 1px solid #000;">
                                <td><strong>Expected in the drawer</strong></td>
                                <td class="text-end"><strong><span t-field="doc.expected_cash"/></strong></td>
                            </tr>
                            <t t-if="doc.report_type == 'z'">
                                <tr><td>Counted</td><td class="text-end"><span t-field="doc.counted_cash"/></td></tr>
                                <tr><td><strong>Difference</strong></td>
                                    <td class="text-end"><strong><span t-field="doc.cash_difference"/></strong></td></tr>
                            </t>
                        </table>
                        <p t-if="doc.report_type == 'x'" class="text-muted">
                            This session is still trading. Nothing has been counted yet,
                            so no difference is shown.
                        </p>

                        <div t-if="doc.note" class="mt-4">
                            <h4>Note</h4>
                            <p t-field="doc.note"/>
                        </div>

                        <div class="mt-5 row">
                            <div class="col-6">
                                <p>Counted by</p>
                                <p>_______________________</p>
                            </div>
                            <div class="col-6">
                                <p>Checked by</p>
                                <p>_______________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
