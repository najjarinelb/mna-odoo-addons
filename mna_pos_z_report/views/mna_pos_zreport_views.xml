<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mna_pos_zreport_form" model="ir.ui.view">
        <field name="name">mna.pos.zreport.form</field>
        <field name="model">mna.pos.zreport</field>
        <field name="arch" type="xml">
            <form string="POS Report" create="false" edit="true">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>
                            <field name="config_id" readonly="1"/>
                            <field name="report_type" readonly="1" class="ms-2"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Session">
                            <field name="session_id" readonly="1"/>
                            <field name="cashier_id" readonly="1"/>
                            <field name="session_start" readonly="1"/>
                            <field name="session_stop" readonly="1"
                                   invisible="report_type == 'x'"/>
                        </group>
                        <group string="Report">
                            <field name="date_taken" readonly="1"/>
                            <field name="taken_by_id" readonly="1"/>
                            <field name="company_id" readonly="1"
                                   groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Trade">
                            <field name="order_count" readonly="1"/>
                            <field name="refund_count" readonly="1"/>
                            <field name="item_count" readonly="1"/>
                            <field name="average_basket" readonly="1"/>
                        </group>
                        <group string="Sales">
                            <field name="gross_sales" readonly="1"/>
                            <field name="discount_total" readonly="1"/>
                            <field name="net_sales" readonly="1"/>
                            <field name="tax_total" readonly="1"/>
                            <field name="total_sales" readonly="1"
                                   class="oe_subtotal_footer_separator"/>
                            <field name="refund_total" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Methods" name="payments">
                            <field name="payment_line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="count" string="Transactions"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tax" name="taxes">
                            <field name="tax_line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="base" sum="Base"/>
                                    <field name="amount" sum="Tax"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Categories" name="categories">
                            <field name="category_line_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="quantity" sum="Items"/>
                                    <field name="amount" sum="Net"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cash" name="cash">
                            <group>
                                <group string="In the drawer">
                                    <field name="opening_float" readonly="1"/>
                                    <field name="cash_sales" readonly="1"/>
                                    <field name="cash_in" readonly="1"/>
                                    <field name="cash_out" readonly="1"/>
                                    <field name="expected_cash" readonly="1"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                                <group string="Counted" invisible="report_type == 'x'">
                                    <field name="counted_cash" readonly="1"/>
                                    <field name="cash_difference" readonly="1"
                                           decoration-danger="cash_difference != 0"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="report_type == 'z'">
                                This session is still trading, so nothing has been counted yet
                                and no difference is shown.
                            </div>
                        </page>
                    </notebook>
                    <group string="Note">
                        <field name="note" nolabel="1"
                               placeholder="Anything worth recording about this day..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mna_pos_zreport_list" model="ir.ui.view">
        <field name="name">mna.pos.zreport.list</field>
        <field name="model">mna.pos.zreport</field>
        <field name="arch" type="xml">
            <list string="POS Reports" create="false">
                <field name="name"/>
                <field name="report_type"/>
                <field name="config_id"/>
                <field name="session_id" optional="show"/>
                <field name="cashier_id" optional="show"/>
                <field name="date_taken"/>
                <field name="order_count" string="Orders"/>
                <field name="total_sales" sum="Total taken"/>
                <field name="cash_difference" sum="Difference"
                       decoration-danger="cash_difference != 0"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_mna_pos_zreport_search" model="ir.ui.view">
        <field name="name">mna.pos.zreport.search</field>
        <field name="model">mna.pos.zreport</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="session_id"/>
                <field name="config_id"/>
                <filter name="z_only" string="Z Reports"
                        domain="[('report_type', '=', 'z')]"/>
                <filter name="x_only" string="X Reports"
                        domain="[('report_type', '=', 'x')]"/>
                <separator/>
                <filter name="with_difference" string="Cash did not balance"
                        domain="[('cash_difference', '!=', 0)]"/>
                <group>
                    <filter name="by_shop" string="Point of Sale" domain="[]"
                            context="{'group_by': 'config_id'}"/>
                    <filter name="by_cashier" string="Cashier" domain="[]"
                            context="{'group_by': 'cashier_id'}"/>
                    <filter name="by_date" string="Date" domain="[]"
                            context="{'group_by': 'date_taken:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mna_pos_zreport" model="ir.actions.act_window">
        <field name="name">X / Z Reports</field>
        <field name="res_model">mna.pos.zreport</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_z_only': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reports taken yet</p>
            <p>
                Take an X report to see where a trading till stands, or a Z report
                to close the day. Z reports are numbered and kept.
            </p>
        </field>
    </record>

    <record id="action_mna_pos_take_x" model="ir.actions.server">
        <field name="name">Take X Report</field>
        <field name="model_id" ref="model_mna_pos_zreport"/>
        <field name="state">code</field>
        <field name="code">action = model.action_take_x()</field>
    </record>

    <record id="action_mna_pos_take_z" model="ir.actions.server">
        <field name="name">Take Z Report</field>
        <field name="model_id" ref="model_mna_pos_zreport"/>
        <field name="state">code</field>
        <field name="code">action = model.action_take_z()</field>
    </record>

    <menuitem id="menu_mna_pos_take_x" name="Take X Report"
              parent="point_of_sale.menu_point_rep" action="action_mna_pos_take_x"
              groups="point_of_sale.group_pos_manager" sequence="40"/>
    <menuitem id="menu_mna_pos_take_z" name="Take Z Report"
              parent="point_of_sale.menu_point_rep" action="action_mna_pos_take_z"
              groups="point_of_sale.group_pos_manager" sequence="41"/>
    <menuitem id="menu_mna_pos_zreport" name="X / Z Reports"
              parent="point_of_sale.menu_point_rep" action="action_mna_pos_zreport"
              groups="point_of_sale.group_pos_manager" sequence="42"/>

    <record id="view_pos_session_form_mna_z" model="ir.ui.view">
        <field name="name">pos.session.form.mna.zreport</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mna_take_report" type="object"
                        string="Take Z Report" class="btn-primary"
                        invisible="state != 'closed'"
                        groups="point_of_sale.group_pos_manager"/>
                <button name="action_mna_take_report" type="object"
                        string="Take X Report"
                        invisible="state != 'opened'"
                        groups="point_of_sale.group_pos_manager"/>
            </xpath>
        </field>
    </record>

</odoo>
