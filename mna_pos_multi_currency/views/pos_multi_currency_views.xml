<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_payment_method_form_mna" model="ir.ui.view">
        <field name="name">pos.payment.method.form.mna.currency</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Payment in Another Currency" name="mna_currency">
                    <field name="mna_foreign_currency_id"
                           options="{'no_create': True}"/>
                    <field name="mna_rate_mode"
                           invisible="not mna_foreign_currency_id"
                           required="mna_foreign_currency_id"/>
                    <field name="mna_fixed_rate"
                           invisible="mna_rate_mode != 'fixed' or not mna_foreign_currency_id"
                           required="mna_rate_mode == 'fixed' and mna_foreign_currency_id"/>
                    <field name="mna_change_in_shop_currency"
                           invisible="not mna_foreign_currency_id"/>
                    <field name="mna_rate_hint" string="Which means"
                           invisible="not mna_foreign_currency_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_pos_session_form_mna" model="ir.ui.view">
        <field name="name">pos.session.form.mna.currency</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Other Currencies Taken" name="mna_currencies"
                       invisible="not mna_foreign_line_ids">
                    <field name="mna_foreign_line_ids" readonly="0">
                        <list editable="bottom" create="false" delete="false">
                            <field name="payment_method_id" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="payment_count" string="Payments" readonly="1"/>
                            <field name="amount_foreign" string="Taken" readonly="1"/>
                            <field name="counted_foreign" string="Counted"/>
                            <field name="difference_foreign" readonly="1"
                                   decoration-danger="difference_foreign != 0"/>
                            <field name="amount_shop" string="Value booked" readonly="1"/>
                            <field name="company_currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <div class="text-muted mt-2">
                        What came in per currency during this session. Count the till in
                        each currency and enter it next to the amount taken.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_list_mna" model="ir.ui.view">
        <field name="name">pos.payment.list.mna.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="mna_amount_foreign" optional="show" string="Paid in"/>
                <field name="mna_foreign_currency_id" optional="show" string="Currency"/>
                <field name="mna_rate_used" optional="hide" string="Rate"/>
            </field>
        </field>
    </record>

</odoo>
